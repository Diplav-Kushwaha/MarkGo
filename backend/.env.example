# MarkGo backend — subscription feature switches
#
# These two settings are optional. With no .env file at all, or with these keys
# missing, the defaults below apply and the app behaves exactly as before the
# subscription feature existed.

# Payment integration mode.
# "dummy" = no real gateway. The simulate-pay endpoints accept and confirm a
#           payment without contacting anything external. No other mode is
#           implemented yet.
# Default when unset: dummy
PAYMENT_MODE=dummy

# Master switch for subscription blocking (plan limits and the "expired company"
# login check). While this is false, subscriptions are recorded but never
# enforced, so the app behaves exactly as it did before this feature.
# Only the exact value "true" (any case) turns enforcement on.
# Default when unset: false
ENFORCE_SUBSCRIPTION=false