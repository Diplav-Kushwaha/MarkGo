generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  COMPANY_ADMIN
  MEMBER
}

model Company {
  id             String   @id @default(uuid())
  name           String
  slug           String   @unique
  email          String   @unique
  address        String?
  gstNumber      String?  @unique
  city           String?
  country        String?

  // Platform-level account state, managed by Super Admin only. Defaults to
  // ACTIVE so every existing company stays usable after the migration.
  status         CompanyStatus @default(ACTIVE)

  // Subscription plan. Optional and not enforced anywhere yet (MVP): no feature
  // gating, usage tracking or proration reads this relation.
  planId         String?
  plan           Plan?         @relation(fields: [planId], references: [id], onDelete: SetNull)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  users          User[]
  customers      Customer[]
  vendors        Vendor[]
  staff          Staff[]
  accountants    Accountant[]
  items          Item[]
  invoices       Invoice[]
  bills          Bill[]
  payments       Payment[]
  settings       CompanySettings?
  subscriptionPayments SubscriptionPayment[]
  subscriptions        Subscription[]

  @@index([status])
  @@index([planId])
  @@map("companies")
}

model CompanySettings {
  id        String  @id @default(uuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Document numbering
  invoicePrefix  String @default("INV")
  billPrefix     String @default("BILL")

  // Tax & money formatting
  defaultTaxPercent Decimal @default(18.00) @db.Decimal(5, 2)
  currency          String  @default("INR")
  decimalPlaces     Int     @default(2)

  // Invoice defaults
  defaultPaymentTermsDays Int     @default(15)
  invoiceNotes           String? @db.Text
  billNotes              String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("company_settings")
}

model User {
  id        String  @id @default(uuid())
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email        String @unique
  passwordHash String
  fullName     String?
  phoneNumber  String?

  role Role @default(MEMBER)

  isEmailVerified         Boolean   @default(false)

  // Platform account state, managed by Super Admin. Defaults to true so every
  // existing user keeps access after the migration. A deactivated user is
  // refused at login.
  isActive                Boolean   @default(true)

  // Written on every successful login so the Super Admin directory can show
  // real last-seen data instead of a placeholder.
  lastLoginAt             DateTime?

  failedLoginAttempts Int            @default(0)
  lockUntil           DateTime?
  refreshTokens       RefreshToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  customersCreated Customer[] @relation("CustomerCreatedBy")
  vendorsCreated   Vendor[]   @relation("VendorCreatedBy")
  staffCreated     Staff[]    @relation("StaffCreatedBy")
  accountantsCreated Accountant[] @relation("AccountantCreatedBy")
  itemsCreated     Item[]     @relation("ItemCreatedBy")
  invoicesCreated  Invoice[]  @relation("InvoiceCreatedBy")
  billsCreated     Bill[]     @relation("BillCreatedBy")
  paymentsRecorded Payment[]  @relation("PaymentRecordedBy")

  @@index([companyId])

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  jti       String    @unique
  expiresAt DateTime
  revoked   Boolean   @default(false)
  revokedAt DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}




enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

enum AddressType {
  BILLING
  SHIPPING
}

model Customer {
  id        String @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  customerType CustomerType @default(BUSINESS)
  name         String       // Full Name or Business Name
  companyName  String?      // Optional Organization/Enterprise name
  email        String
  phoneNumber  String?
  alternatePhone String?

  // Tax & Identity
  taxNumber    String?      // GSTIN / Tax ID
  panNumber    String?      // PAN for Indian tax compliance
  currency     String       @default("INR")
  paymentTerms String?      @default("DUE_ON_RECEIPT") // e.g., NET_15, NET_30, NET_45, DUE_ON_RECEIPT
  creditLimit  Decimal?     @db.Decimal(12, 2)
  openingBalance Decimal    @default(0.00) @db.Decimal(12, 2)

  // Derived Financial Records (stored or computed)
  totalInvoiced  Decimal    @default(0.00) @db.Decimal(12, 2)
  totalPaid      Decimal    @default(0.00) @db.Decimal(12, 2)
  outstandingBalance Decimal @default(0.00) @db.Decimal(12, 2)
  lastInvoiceDate DateTime?
  lastPaymentDate DateTime?

  notes        String?      @db.Text

  // Auth & Session
  passwordHash         String?
  isEmailVerified      Boolean   @default(false)
  failedLoginAttempts  Int       @default(0)
  lockUntil            DateTime?
  inviteTokens         CustomerInviteToken[]
  refreshTokens        CustomerRefreshToken[]

  status CustomerStatus @default(ACTIVE)
  isDeleted Boolean     @default(false)
  deletedAt DateTime?

  createdByUserId String?
  createdBy       User?   @relation("CustomerCreatedBy", fields: [createdByUserId], references: [id])

    addresses Address[]
  invoices  Invoice[]
  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([companyId, email])
  @@index([companyId, status, isDeleted])
  @@index([companyId, customerType])
  @@map("customers")
}

model CustomerInviteToken {
  id         String    @id @default(uuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?

  createdAt  DateTime  @default(now())

  @@index([customerId])
  @@map("customer_invite_tokens")
}

model CustomerRefreshToken {
  id         String    @id @default(uuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  tokenHash  String    @unique
  jti        String
  expiresAt  DateTime
  ipAddress  String?
  userAgent  String?
  revoked    Boolean   @default(false)
  revokedAt  DateTime?

  createdAt  DateTime  @default(now())

  @@index([customerId])
  @@map("customer_refresh_tokens")
}

model Address {
  id         String @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  type       AddressType
  line1      String
  line2      String?
  city       String?
  state      String?
  country    String?
  postalCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@map("addresses")
}

enum VendorStatus {
  ACTIVE
  INACTIVE
}

enum VendorType {
  INDIVIDUAL
  BUSINESS
  SERVICE_PROVIDER
}

model Vendor {
  id        String @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Basic Info
  name            String       // Vendor Name / Business Name
  companyName     String?      // Organization / Trade Name
  contactPerson   String?      // Contact Person Name
  vendorType      VendorType   @default(BUSINESS)
  category        String?      // Category / Type of goods or services supplied
  email           String
  phoneNumber     String?
  alternatePhone  String?

  // Tax & Identity
  taxNumber       String?      // GSTIN / Tax ID
  panNumber       String?      // PAN for TDS / High-value transactions
  currency        String       @default("INR")
  paymentTerms    String?      @default("DUE_ON_RECEIPT") // e.g. NET_15, NET_30, NET_45, DUE_ON_RECEIPT
  creditLimit     Decimal?     @db.Decimal(12, 2)
  openingBalance  Decimal      @default(0.00) @db.Decimal(12, 2)

  // Bank Account Details
  bankAccountNumber String?
  bankIfsc          String?
  bankName          String?
  bankBranch        String?

  // Derived Financial Records (stored / computed)
  totalPurchased       Decimal   @default(0.00) @db.Decimal(12, 2)
  totalPaid            Decimal   @default(0.00) @db.Decimal(12, 2)
  outstandingPayable   Decimal   @default(0.00) @db.Decimal(12, 2)
  lastBillDate         DateTime?
  lastPaymentDate      DateTime?

  notes           String?      @db.Text

  // Auth & Session
  passwordHash         String?
  isEmailVerified      Boolean   @default(false)
  failedLoginAttempts  Int       @default(0)
  lockUntil            DateTime?
  inviteTokens         VendorInviteToken[]
  refreshTokens        VendorRefreshToken[]

  status VendorStatus @default(ACTIVE)
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdByUserId String?
  createdBy       User?   @relation("VendorCreatedBy", fields: [createdByUserId], references: [id])

  addresses VendorAddress[]
  items     Item[]
  bills     Bill[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, email])
  @@index([companyId, status, isDeleted])
  @@index([companyId, vendorType])
  @@map("vendors")
}

model VendorInviteToken {
  id         String    @id @default(uuid())
  vendorId   String
  vendor     Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?

  createdAt  DateTime  @default(now())

  @@index([vendorId])
  @@map("vendor_invite_tokens")
}

model VendorRefreshToken {
  id         String    @id @default(uuid())
  vendorId   String
  vendor     Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  tokenHash  String    @unique
  jti        String
  expiresAt  DateTime
  ipAddress  String?
  userAgent  String?
  revoked    Boolean   @default(false)
  revokedAt  DateTime?

  createdAt  DateTime  @default(now())

  @@index([vendorId])
  @@map("vendor_refresh_tokens")
}

model VendorAddress {
  id         String @id @default(uuid())
  vendorId   String
  vendor     Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  type       AddressType
  line1      String
  line2      String?
  city       String?
  state      String?
  country    String?
  postalCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId])
  @@map("vendor_addresses")
}

enum StaffStatus {
  ACTIVE
  INACTIVE
}

model Staff {
  id          String      @id @default(uuid())
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name        String
  email       String
  phoneNumber String?
  designation String?
  department  String?

  passwordHash         String?
  isEmailVerified      Boolean     @default(false)
  failedLoginAttempts  Int         @default(0)
  lockUntil            DateTime?
  inviteTokens         StaffInviteToken[]
  refreshTokens        StaffRefreshToken[]

  status          StaffStatus @default(ACTIVE)
  createdByUserId String?
  createdBy       User?       @relation("StaffCreatedBy", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, email])
  @@index([companyId, status])
  @@map("staff")
}

model StaffInviteToken {
  id         String    @id @default(uuid())
  staffId    String
  staff      Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)

  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?

  createdAt  DateTime  @default(now())

  @@index([staffId])
  @@map("staff_invite_tokens")
}

model StaffRefreshToken {
  id         String    @id @default(uuid())
  staffId    String
  staff      Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)

  tokenHash  String    @unique
  jti        String
  expiresAt  DateTime
  ipAddress  String?
  userAgent  String?
  revoked    Boolean   @default(false)
  revokedAt  DateTime?

  createdAt  DateTime  @default(now())

  @@index([staffId])
  @@map("staff_refresh_tokens")
}

enum AccountantStatus {
  ACTIVE
  INACTIVE
}

model Accountant {
  id            String            @id @default(uuid())
  companyId     String
  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name          String
  email         String
  phoneNumber   String?
  licenseNumber String?
  experience    String?

  passwordHash         String?
  isEmailVerified      Boolean           @default(false)
  failedLoginAttempts  Int               @default(0)
  lockUntil            DateTime?
  inviteTokens         AccountantInviteToken[]
  refreshTokens        AccountantRefreshToken[]

  status          AccountantStatus  @default(ACTIVE)
  createdByUserId String?
  createdBy       User?             @relation("AccountantCreatedBy", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, email])
  @@index([companyId, status])
  @@map("accountants")
}

model AccountantInviteToken {
  id           String      @id @default(uuid())
  accountantId String
  accountant   Accountant  @relation(fields: [accountantId], references: [id], onDelete: Cascade)

  tokenHash    String      @unique
  expiresAt    DateTime
  usedAt       DateTime?

  createdAt    DateTime    @default(now())

  @@index([accountantId])
  @@map("accountant_invite_tokens")
}

model AccountantRefreshToken {
  id           String      @id @default(uuid())
  accountantId String
  accountant   Accountant  @relation(fields: [accountantId], references: [id], onDelete: Cascade)

  tokenHash    String      @unique
  jti          String
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  revoked      Boolean     @default(false)
  revokedAt    DateTime?

  createdAt    DateTime    @default(now())

  @@index([accountantId])
  @@map("accountant_refresh_tokens")
}

enum ItemType {
  PRODUCT
  SERVICE
}

enum ItemStatus {
  ACTIVE
  INACTIVE
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

model Item {
  id          String      @id @default(uuid())
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  type        ItemType    @default(PRODUCT)
  name        String
  sku         String?     // Unique per company
  barcode     String?

  // Categorization
  category    String?
  subCategory String?
  brand       String?
  tags        String?     // Comma-separated tags or JSON

  // Tax & Legal (Indian GST)
  hsnCode     String?     // For products
  sacCode     String?     // For services
  taxRate     Decimal     @default(0.00) @db.Decimal(5, 2) // e.g. 0, 5, 12, 18, 28
  isPriceInclusiveTax Boolean @default(false)

  // Pricing
  salesPrice    Decimal   @default(0.00) @db.Decimal(12, 2)
  purchasePrice Decimal?  @db.Decimal(12, 2)
  discountType  DiscountType?
  discountValue Decimal?  @db.Decimal(12, 2)

  // Unit of Measurement
  unit        String      @default("pcs") // pcs, kg, box, hrs, session, visit, etc.

  // Inventory / Stock Tracking (Products only)
  trackInventory Boolean  @default(true)
  stockQuantity  Decimal  @default(0.00) @db.Decimal(12, 2)
  openingStock   Decimal  @default(0.00) @db.Decimal(12, 2)
  reorderLevel   Decimal  @default(0.00) @db.Decimal(12, 2) // Low-stock threshold
  allowBackorder Boolean  @default(false)

  // Metadata & Media
  description String?     @db.Text
  imageUrl    String?

  // Relations & Audit
  linkedVendorId String?
  linkedVendor   Vendor?  @relation(fields: [linkedVendorId], references: [id], onDelete: SetNull)

  status      ItemStatus  @default(ACTIVE)
  isDeleted   Boolean     @default(false) // Soft delete support
  deletedAt   DateTime?

  createdByUserId String?
  createdBy       User?   @relation("ItemCreatedBy", fields: [createdByUserId], references: [id])

    createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  invoiceItems InvoiceItem[]
  billItems     BillItem[]

  @@unique([companyId, sku])

  @@index([companyId, status, isDeleted])
    @@index([companyId, type])
  @@index([companyId, category])
  @@map("items")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum InvoiceItemType {
  PRODUCT
  SERVICE
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  UPI
  RAZORPAY
  STRIPE
  PAYPAL
  CASHFREE
  OTHER
}

model Invoice {
  id            String        @id @default(uuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoiceNumber String        // INV-YYYY-####
  invoiceDate   DateTime
  dueDate       DateTime
  status        InvoiceStatus @default(DRAFT)

  subtotal      Decimal       @default(0.00) @db.Decimal(12, 2)
  discountTotal Decimal       @default(0.00) @db.Decimal(12, 2)
  taxTotal      Decimal       @default(0.00) @db.Decimal(12, 2)
  grandTotal    Decimal       @default(0.00) @db.Decimal(12, 2)
  amountPaid    Decimal       @default(0.00) @db.Decimal(12, 2)
  amountDue     Decimal       @default(0.00) @db.Decimal(12, 2)

  currency           String   @default("INR")
  notes              String?  @db.Text
  termsAndConditions String?  @db.Text

  createdById String
  createdBy   User   @relation("InvoiceCreatedBy", fields: [createdById], references: [id])

  items    InvoiceItem[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, invoiceNumber])
  @@index([companyId, status])
  @@index([companyId, customerId])
  @@index([companyId, invoiceDate])
  @@map("invoices")
}

model InvoiceItem {
  id          String          @id @default(uuid())
  invoiceId   String
  invoice     Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  itemType    InvoiceItemType
  itemId      String?         // Reference to Item model (Product/Service)
  item        Item?           @relation(fields: [itemId], references: [id], onDelete: SetNull)
  description String          @db.Text
  quantity    Decimal         @db.Decimal(10, 2)
  unitPrice   Decimal         @db.Decimal(12, 2)
  taxRate     Decimal         @default(0.00) @db.Decimal(5, 2)
  discount    Decimal         @default(0.00) @db.Decimal(12, 2)
  lineTotal   Decimal         @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@map("invoice_items")
}

enum BillStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

model Bill {
  id          String     @id @default(uuid())
  companyId   String
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vendorId    String
  vendor      Vendor     @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  billNumber  String
  billDate    DateTime
  dueDate     DateTime?
  category    String?
  status      BillStatus @default(UNPAID)

  total       Decimal    @default(0.00) @db.Decimal(12, 2)
  amountPaid  Decimal    @default(0.00) @db.Decimal(12, 2)
  amountDue   Decimal    @default(0.00) @db.Decimal(12, 2)

  currency    String     @default("INR")
  notes       String?    @db.Text
  attachmentUrl String?

  createdById String
  createdBy   User       @relation("BillCreatedBy", fields: [createdById], references: [id])

  items    BillItem[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, billNumber])
  @@index([companyId, status])
  @@index([companyId, vendorId])
  @@index([companyId, billDate])
  @@map("bills")
}

model BillItem {
  id          String   @id @default(uuid())
  billId      String
  bill        Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  itemId      String?  // Reference to Item model (Product/Service)
  item        Item?    @relation(fields: [itemId], references: [id], onDelete: SetNull)
  description String   @db.Text
  quantity    Decimal  @default(1.00) @db.Decimal(10, 2)
  unitPrice   Decimal  @default(0.00) @db.Decimal(12, 2)
  amount      Decimal  @default(0.00) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([billId])
  @@index([itemId])
  @@map("bill_items")
}

model Payment {
  id        String        @id @default(uuid())
  companyId String
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoiceId String?
  invoice   Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  billId    String?
  bill      Bill?         @relation(fields: [billId], references: [id], onDelete: Cascade)
  amount    Decimal       @db.Decimal(12, 2)
  method    PaymentMethod
  reference String?
  note      String?       @db.Text

  paymentDate  DateTime
  recordedById String
  recordedBy   User     @relation("PaymentRecordedBy", fields: [recordedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([invoiceId])
  @@index([billId])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Super Admin: platform subscriptions
// ---------------------------------------------------------------------------

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  CANCELLED

  // The company has registered on a paid plan but has not completed payment yet.
  // Appended last on purpose: MySQL stores enum values by ordinal, so adding a
  // value at the end leaves ACTIVE/SUSPENDED/CANCELLED at 0/1/2 and rewrites no
  // existing rows.
  PENDING_PAYMENT
}

// How often a plan bills and how long one period lasts.
enum BillingCycle {
  FREE
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum SubscriptionPaymentStatus {
  PENDING
  PAID
  FAILED
}

/// A subscription plan a company can be on. The limit columns are display-only
/// for the MVP: nothing in the codebase reads them to restrict a company, and
/// changing a plan causes no proration or billing side effects.
model Plan {
  id          String   @id @default(uuid())
  name        String   @unique
  price       Decimal  @db.Decimal(12, 2)
  description String?  @db.Text

  // MONTHLY by default so any pre-existing Plan row migrates cleanly; the seed
  // step sets the correct cycle (FREE / MONTHLY / YEARLY) per plan.
  billingCycle BillingCycle @default(MONTHLY)

  // Length of one billing period in months. Empty for FREE, which never expires.
  durationMonths Int?

  // Display labels for the plan card. Not enforced. Empty means unlimited.
  maxUsers     Int?
  maxCustomers Int?
  maxVendors   Int?
  maxStaff     Int?
  maxInvoices  Int?

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  companies            Company[]
  subscriptions        Subscription[]
  subscriptionPayments SubscriptionPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("plans")
}

/// What one company bought: which plan, for which period, and how much it cost.
/// The price and billing cycle are copied in at purchase time so editing a plan
/// later never changes a subscription that already exists. A null endDate means
/// the subscription never expires (FREE).
model Subscription {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  planId    String
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Restrict)

  status SubscriptionStatus @default(PENDING)

  // Snapshotted from the plan when the subscription was created.
  billingCycle   BillingCycle
  priceAtPurchase Decimal     @db.Decimal(12, 2)

  startDate DateTime?
  endDate   DateTime?

  // Who set this up: "SELF" (the company), "SUPERADMIN" or "SYSTEM".
  createdBy String?

  payments SubscriptionPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([endDate])
  @@map("subscriptions")
}

/// A single subscription billing record. For the MVP these are created manually
/// (Super Admin or the seed script) and reconciled by hand — there is no payment
/// gateway, no automatic generation and no retry logic.
model SubscriptionPayment {
  id        String @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  planId    String
  plan      Plan    @relation(fields: [planId], references: [id], onDelete: Restrict)

  // Set when this payment settles a specific subscription; empty for a payment
  // recorded directly against the company.
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  amount Decimal                  @db.Decimal(12, 2)
  status SubscriptionPaymentStatus @default(PENDING)
  paidAt DateTime?
  note   String?                  @db.Text

  // How this payment was taken: "DUMMY" for the simulated flow, "MANUAL" for a
  // Super Admin recording one by hand. No gateway fields — payment is dummy.
  paymentMethod String? @default("DUMMY")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([planId])
  @@index([subscriptionId])
  @@index([status])
  @@index([paidAt])
  @@map("subscription_payments")
}

