generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Company {
  id                   String                @id @default(uuid())
  name                 String
  slug                 String                @unique
  email                String?               @unique
  address              String?
  gstNumber            String?               @unique
  city                 String?
  country              String?
  status               CompanyStatus         @default(ACTIVE)
  planId               String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  currency             String                @default("INR")
  financialYearStart   Int                   @default(4)
  state                String?
  bills                Bill[]
  categories           Category[]
  plan                 Plan?                 @relation(fields: [planId], references: [id])
  settings             CompanySettings?
  customers            Customer[]
  invoices             Invoice[]
  items                Item[]
  payments             Payment[]
  staff                Staff[]
  subscriptionPayments SubscriptionPayment[]
  subscriptions        Subscription[]
  units                Unit[]
  users                User[]
  vendors              Vendor[]

  @@index([status])
  @@index([planId])
  @@map("companies")
}

model CompanySettings {
  id                      String   @id @default(uuid())
  companyId               String   @unique
  invoicePrefix           String   @default("INV")
  billPrefix              String   @default("BILL")
  defaultTaxPercent       Decimal  @default(18.00) @db.Decimal(5, 2)
  currency                String   @default("INR")
  decimalPlaces           Int      @default(2)
  defaultPaymentTermsDays Int      @default(15)
  invoiceNotes            String?  @db.Text
  billNotes               String?  @db.Text
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  company                 Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("company_settings")
}

model User {
  id                  String         @id @default(uuid())
  companyId           String?
  email               String?        @unique
  passwordHash        String
  fullName            String?
  phoneNumber         String         @unique
  role                Role           @default(MEMBER)
  isEmailVerified     Boolean        @default(false)
  isActive            Boolean        @default(true)
  lastLoginAt         DateTime?
  failedLoginAttempts Int            @default(0)
  lockUntil           DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  billsCreated        Bill[]         @relation("BillCreatedBy")
  customersCreated    Customer[]     @relation("CustomerCreatedBy")
  invoicesCreated     Invoice[]      @relation("InvoiceCreatedBy")
  itemsCreated        Item[]         @relation("ItemCreatedBy")
  paymentsRecorded    Payment[]      @relation("PaymentRecordedBy")
  refreshTokens       RefreshToken[]
  staffCreated        Staff[]        @relation("StaffCreatedBy")
  company             Company?       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vendorsCreated      Vendor[]       @relation("VendorCreatedBy")

  @@index([companyId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  jti       String    @unique
  expiresAt DateTime
  revoked   Boolean   @default(false)
  revokedAt DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Customer {
  id                  String                 @id @default(uuid())
  companyId           String
  customerType        CustomerType           @default(BUSINESS)
  name                String
  companyName         String?
  email               String?
  phoneNumber         String
  alternatePhone      String?
  taxNumber           String?
  panNumber           String?
  currency            String                 @default("INR")
  paymentTerms        String?                @default("DUE_ON_RECEIPT")
  creditLimit         Decimal?               @db.Decimal(12, 2)
  openingBalance      Decimal                @default(0.00) @db.Decimal(12, 2)
  totalInvoiced       Decimal                @default(0.00) @db.Decimal(12, 2)
  totalPaid           Decimal                @default(0.00) @db.Decimal(12, 2)
  outstandingBalance  Decimal                @default(0.00) @db.Decimal(12, 2)
  lastInvoiceDate     DateTime?
  lastPaymentDate     DateTime?
  notes               String?                @db.Text
  passwordHash        String?
  isEmailVerified     Boolean                @default(false)
  failedLoginAttempts Int                    @default(0)
  lockUntil           DateTime?
  status              CustomerStatus         @default(ACTIVE)
  isDeleted           Boolean                @default(false)
  deletedAt           DateTime?
  createdByUserId     String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  addresses           Address[]
  inviteTokens        CustomerInviteToken[]
  refreshTokens       CustomerRefreshToken[]
  company             Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy           User?                  @relation("CustomerCreatedBy", fields: [createdByUserId], references: [id])
  invoices            Invoice[]

  @@unique([companyId, email])
  @@unique([companyId, phoneNumber])
  @@index([companyId, status, isDeleted])
  @@index([companyId, customerType])
  @@index([createdByUserId], map: "customers_createdByUserId_fkey")
  @@map("customers")
}

model CustomerInviteToken {
  id         String    @id @default(uuid())
  customerId String
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_invite_tokens")
}

model CustomerRefreshToken {
  id         String    @id @default(uuid())
  customerId String
  tokenHash  String    @unique
  jti        String
  expiresAt  DateTime
  ipAddress  String?
  userAgent  String?
  revoked    Boolean   @default(false)
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_refresh_tokens")
}

model Address {
  id         String      @id @default(uuid())
  customerId String
  type       AddressType
  line1      String
  line2      String?
  city       String?
  state      String?
  country    String?
  postalCode String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("addresses")
}

model Vendor {
  id                  String               @id @default(uuid())
  companyId           String
  name                String
  companyName         String?
  contactPerson       String?
  vendorType          VendorType           @default(BUSINESS)
  category            String?
  email               String?
  phoneNumber         String
  alternatePhone      String?
  taxNumber           String?
  panNumber           String?
  currency            String               @default("INR")
  paymentTerms        String?              @default("DUE_ON_RECEIPT")
  creditLimit         Decimal?             @db.Decimal(12, 2)
  openingBalance      Decimal              @default(0.00) @db.Decimal(12, 2)
  bankAccountNumber   String?
  bankIfsc            String?
  bankName            String?
  bankBranch          String?
  totalPurchased      Decimal              @default(0.00) @db.Decimal(12, 2)
  totalPaid           Decimal              @default(0.00) @db.Decimal(12, 2)
  outstandingPayable  Decimal              @default(0.00) @db.Decimal(12, 2)
  lastBillDate        DateTime?
  lastPaymentDate     DateTime?
  notes               String?              @db.Text
  passwordHash        String?
  isEmailVerified     Boolean              @default(false)
  failedLoginAttempts Int                  @default(0)
  lockUntil           DateTime?
  status              VendorStatus         @default(ACTIVE)
  isDeleted           Boolean              @default(false)
  deletedAt           DateTime?
  createdByUserId     String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  bills               Bill[]
  items               Item[]
  addresses           VendorAddress[]
  inviteTokens        VendorInviteToken[]
  refreshTokens       VendorRefreshToken[]
  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy           User?                @relation("VendorCreatedBy", fields: [createdByUserId], references: [id])

  @@unique([companyId, email])
  @@unique([companyId, phoneNumber])
  @@index([companyId, status, isDeleted])
  @@index([companyId, vendorType])
  @@index([createdByUserId], map: "vendors_createdByUserId_fkey")
  @@map("vendors")
}

model VendorInviteToken {
  id        String    @id @default(uuid())
  vendorId  String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  vendor    Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@map("vendor_invite_tokens")
}

model VendorRefreshToken {
  id        String    @id @default(uuid())
  vendorId  String
  tokenHash String    @unique
  jti       String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  revoked   Boolean   @default(false)
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  vendor    Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@map("vendor_refresh_tokens")
}

model VendorAddress {
  id         String      @id @default(uuid())
  vendorId   String
  type       AddressType
  line1      String
  line2      String?
  city       String?
  state      String?
  country    String?
  postalCode String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  vendor     Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@map("vendor_addresses")
}

model Staff {
  id                  String              @id @default(uuid())
  companyId           String
  name                String
  email               String?
  phoneNumber         String
  designation         String?
  department          String?
  passwordHash        String?
  isEmailVerified     Boolean             @default(false)
  failedLoginAttempts Int                 @default(0)
  lockUntil           DateTime?
  status              StaffStatus         @default(ACTIVE)
  createdByUserId     String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  company             Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy           User?               @relation("StaffCreatedBy", fields: [createdByUserId], references: [id])
  inviteTokens        StaffInviteToken[]
  refreshTokens       StaffRefreshToken[]

  @@unique([companyId, email])
  @@unique([companyId, phoneNumber])
  @@index([companyId, status])
  @@index([createdByUserId], map: "staff_createdByUserId_fkey")
  @@map("staff")
}

model StaffInviteToken {
  id        String    @id @default(uuid())
  staffId   String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  staff     Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@map("staff_invite_tokens")
}

model StaffRefreshToken {
  id        String    @id @default(uuid())
  staffId   String
  tokenHash String    @unique
  jti       String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  revoked   Boolean   @default(false)
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  staff     Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@map("staff_refresh_tokens")
}

model Item {
  id                   String              @id @default(uuid())
  companyId            String
  type                 ItemType            @default(PRODUCT)
  name                 String
  sku                  String?
  barcode              String?

  // New product-specific fields
  productCode          String?             // Required by backend validation for products only
  unitId               String?
  unitRel              Unit?               @relation(fields: [unitId], references: [id], onDelete: SetNull)
  categoryId           String?
  categoryRel          Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sellingPriceTaxMode  PriceTaxMode        @default(NONE)
  purchasePriceTaxMode PriceTaxMode?
  discountPercent      Decimal?            @db.Decimal(5, 2) // Product-level default discount percentage
  hsnSacCode           String?

  // Categorization (legacy string fields, kept for backward compatibility)
  category             String?
  subCategory          String?
  brand                String?
  tags                 String?             // Comma-separated tags or JSON

  // Tax & Legal (Indian GST)
  hsnCode              String?             // For products
  sacCode              String?             // For services
  taxRate              Decimal             @default(0.00) @db.Decimal(5, 2) // e.g. 0, 5, 12, 18, 28
  isPriceInclusiveTax  Boolean             @default(false)

  // Pricing
  salesPrice           Decimal             @default(0.00) @db.Decimal(12, 2)
  purchasePrice        Decimal?            @db.Decimal(12, 2)
  discountType         items_discountType?
  discountValue        Decimal?            @db.Decimal(12, 2)

  // Unit of Measurement (legacy string field, kept for backward compatibility)
  unit                 String              @default("pcs") // pcs, kg, box, hrs, session, visit, etc.

  // Inventory / Stock Tracking (Products only)
  trackInventory       Boolean             @default(true)
  stockQuantity        Decimal             @default(0.00) @db.Decimal(12, 2)
  openingStock         Decimal             @default(0.00) @db.Decimal(12, 2)
  reorderLevel         Decimal             @default(0.00) @db.Decimal(12, 2)
  allowBackorder       Boolean             @default(false)

  // Metadata & Media
  description          String?             @db.Text
  imageUrl             String?

  // Relations & Audit
  linkedVendorId       String?
  linkedVendor         Vendor?             @relation(fields: [linkedVendorId], references: [id], onDelete: SetNull)

  status               items_status        @default(ACTIVE)
  isDeleted            Boolean             @default(false)
  deletedAt            DateTime?
  createdByUserId      String?
  createdBy            User?               @relation("ItemCreatedBy", fields: [createdByUserId], references: [id])
  company              Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  billItems            BillItem[]
  invoiceItems         InvoiceItem[]

  @@index([companyId, status, isDeleted])
  @@index([companyId, type])
  @@index([companyId, category])
  @@index([categoryId], map: "items_categoryId_fkey")
  @@unique([companyId, sku])
  @@index([companyId, productCode])
  @@index([createdByUserId], map: "items_createdByUserId_fkey")
  @@index([linkedVendorId], map: "items_linkedVendorId_fkey")
  @@index([unitId], map: "items_unitId_fkey")
  @@map("items")
}

/// A unit of measurement. When `companyId` is NULL the row is a built-in unit
/// shared by every company (read-only). When `companyId` is set it is a custom
/// unit owned by that company.
model Unit {
  id           String   @id @default(uuid())
  companyId    String?
  fullName     String   @db.VarChar(200)
  shortName    String   @db.VarChar(50)
  isSystem     Boolean  @default(false)
  isPackage    Boolean  @default(false)
  quantity     Decimal? @db.Decimal(12, 4)
  baseUnitId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  items        Item[]
  baseUnit     Unit?    @relation("UnitBaseUnit", fields: [baseUnitId], references: [id])
  packageUnits Unit[]   @relation("UnitBaseUnit")
  company      Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, fullName])
  @@unique([companyId, shortName])
  @@index([companyId])
  @@index([baseUnitId])
  @@map("units")
}

/// A product/service category. NULL `companyId` = built-in shared category.
model Category {
  id        String       @id @default(uuid())
  companyId String?
  name      String       @db.VarChar(100)
  type      CategoryType
  isSystem  Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  company   Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items     Item[]

  @@unique([companyId, name, type])
  @@index([companyId])
  @@map("categories")
}

model Invoice {
  id                 String        @id @default(uuid())
  companyId          String
  customerId         String
  invoiceNumber      String
  invoiceDate        DateTime
  dueDate            DateTime
  status             InvoiceStatus @default(DRAFT)
  subtotal           Decimal       @default(0.00) @db.Decimal(12, 2)
  discountTotal      Decimal       @default(0.00) @db.Decimal(12, 2)
  taxTotal           Decimal       @default(0.00) @db.Decimal(12, 2)
  grandTotal         Decimal       @default(0.00) @db.Decimal(12, 2)
  amountPaid         Decimal       @default(0.00) @db.Decimal(12, 2)
  amountDue          Decimal       @default(0.00) @db.Decimal(12, 2)
  currency           String        @default("INR")
  notes              String?       @db.Text
  termsAndConditions String?       @db.Text
  createdById        String
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  items              InvoiceItem[]
  company            Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy          User          @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  customer           Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  payments           Payment[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId, status])
  @@index([companyId, customerId])
  @@index([companyId, invoiceDate])
  @@index([createdById], map: "invoices_createdById_fkey")
  @@index([customerId], map: "invoices_customerId_fkey")
  @@map("invoices")
}

model InvoiceItem {
  id          String          @id @default(uuid())
  invoiceId   String
  itemType    InvoiceItemType
  itemId      String?
  description String          @db.Text
  quantity    Decimal         @db.Decimal(10, 2)
  unitPrice   Decimal         @db.Decimal(12, 2)
  taxRate     Decimal         @default(0.00) @db.Decimal(5, 2)
  discount    Decimal         @default(0.00) @db.Decimal(12, 2)
  lineTotal   Decimal         @db.Decimal(12, 2)
  createdAt   DateTime        @default(now())
  invoice     Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item        Item?           @relation(fields: [itemId], references: [id])

  @@index([invoiceId])
  @@index([itemId], map: "invoice_items_itemId_fkey")
  @@map("invoice_items")
}

model Bill {
  id            String     @id @default(uuid())
  companyId     String
  vendorId      String
  billNumber    String
  billDate      DateTime
  dueDate       DateTime?
  category      String?
  status        BillStatus @default(UNPAID)
  total         Decimal    @default(0.00) @db.Decimal(12, 2)
  amountPaid    Decimal    @default(0.00) @db.Decimal(12, 2)
  amountDue     Decimal    @default(0.00) @db.Decimal(12, 2)
  currency      String     @default("INR")
  notes         String?    @db.Text
  attachmentUrl String?
  createdById   String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  items         BillItem[]
  company       Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy     User       @relation("BillCreatedBy", fields: [createdById], references: [id])
  vendor        Vendor     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  payments      Payment[]

  @@unique([companyId, billNumber])
  @@index([companyId, status])
  @@index([companyId, vendorId])
  @@index([companyId, billDate])
  @@index([createdById], map: "bills_createdById_fkey")
  @@index([vendorId], map: "bills_vendorId_fkey")
  @@map("bills")
}

model BillItem {
  id          String   @id @default(uuid())
  billId      String
  itemId      String?
  description String   @db.Text
  quantity    Decimal  @default(1.00) @db.Decimal(10, 2)
  unitPrice   Decimal  @default(0.00) @db.Decimal(12, 2)
  amount      Decimal  @default(0.00) @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  bill        Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  item        Item?    @relation(fields: [itemId], references: [id])

  @@index([billId])
  @@index([itemId])
  @@map("bill_items")
}

model Payment {
  id           String        @id @default(uuid())
  companyId    String
  invoiceId    String?
  billId       String?
  amount       Decimal       @db.Decimal(12, 2)
  method       PaymentMethod
  reference    String?
  note         String?       @db.Text
  paymentDate  DateTime
  recordedById String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  bill         Bill?         @relation(fields: [billId], references: [id], onDelete: Cascade)
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice      Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedBy   User          @relation("PaymentRecordedBy", fields: [recordedById], references: [id])

  @@index([companyId])
  @@index([invoiceId])
  @@index([billId])
  @@index([recordedById], map: "payments_recordedById_fkey")
  @@map("payments")
}

/// A subscription plan a company can be on. The limit columns are display-only
/// for the MVP: nothing in the codebase reads them to restrict a company, and
/// changing a plan causes no proration or billing side effects.
model Plan {
  id                   String                @id @default(uuid())
  name                 String                @unique
  price                Decimal               @db.Decimal(12, 2)
  description          String?               @db.Text
  maxUsers             Int?
  maxCustomers         Int?
  maxInvoices          Int?
  isActive             Boolean               @default(true)
  sortOrder            Int                   @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  billingCycle         BillingCycle          @default(MONTHLY)
  durationMonths       Int?
  maxStaff             Int?
  maxVendors           Int?
  companies            Company[]
  subscriptionPayments SubscriptionPayment[]
  subscriptions        Subscription[]

  @@map("plans")
}

/// What one company bought: which plan, for which period, and how much it cost.
/// The price and billing cycle are copied in at purchase time so editing a plan
/// later never changes a subscription that already exists. A null endDate means
/// the subscription never expires (FREE).
model Subscription {
  id              String                @id @default(uuid())
  companyId       String
  planId          String
  status          SubscriptionStatus    @default(PENDING)
  billingCycle    BillingCycle
  priceAtPurchase Decimal               @db.Decimal(12, 2)
  startDate       DateTime?
  endDate         DateTime?
  createdBy       String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  payments        SubscriptionPayment[]
  company         Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan            Plan                  @relation(fields: [planId], references: [id])

  @@index([companyId, status])
  @@index([endDate])
  @@index([planId], map: "subscriptions_planId_fkey")
  @@map("subscriptions")
}

/// A single subscription billing record. For the MVP these are created manually
/// (Super Admin or the seed script) and reconciled by hand — there is no payment
/// gateway, no automatic generation and no retry logic.
model SubscriptionPayment {
  id             String                    @id @default(uuid())
  companyId      String
  planId         String
  amount         Decimal                   @db.Decimal(12, 2)
  status         SubscriptionPaymentStatus @default(PENDING)
  paidAt         DateTime?
  note           String?                   @db.Text
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  paymentMethod  String?                   @default("DUMMY")
  subscriptionId String?
  company        Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan           Plan                      @relation(fields: [planId], references: [id])
  subscription   Subscription?             @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([planId])
  @@index([subscriptionId])
  @@index([status])
  @@index([paidAt])
  @@map("subscription_payments")
}

enum Role {
  SUPERADMIN
  COMPANY_ADMIN
  MEMBER
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

enum AddressType {
  BILLING
  SHIPPING
}

enum VendorStatus {
  ACTIVE
  INACTIVE
}

enum VendorType {
  INDIVIDUAL
  BUSINESS
  SERVICE_PROVIDER
}

enum StaffStatus {
  ACTIVE
  INACTIVE
}

enum ItemType {
  PRODUCT
  SERVICE
}

enum PriceTaxMode {
  INCLUSIVE
  EXCLUSIVE
  NONE
}

/// What a category classifies: a Product category or a Service category.
enum CategoryType {
  PRODUCT
  SERVICE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum InvoiceItemType {
  PRODUCT
  SERVICE
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  UPI
  RAZORPAY
  STRIPE
  PAYPAL
  CASHFREE
  OTHER
}

